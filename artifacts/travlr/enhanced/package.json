{
  "name": "travlr",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test:security": "node tests/security-middleware.test.js",
    "test:algorithms": "node tests/login-attempt-tracker.test.js",
    "test:all": "npm run test:security && npm run test:algorithms && npm run test:database",
    "test:database": "node tests/database-constraints.test.js && node tests/database-models.test.js",
    "db:migrate:check": "node scripts/migrate-database.js",
    "db:migrate:apply": "node scripts/migrate-database.js --apply"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "crypto": "^1.0.1",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-jwt": "^8.5.1",
    "hbs": "^4.2.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  }
}
